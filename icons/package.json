{
  "name": "defyne-icons",
  "version": "1.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "generate": "bunx @svgr/cli --config-file .svgrrc.json --template template.cjs --out-dir src svgs",
    "build:js": "bun build ./src/index.ts --outdir ./dist --format esm --external react",
    "build:types": "tsc",
    "clean": "rm -rf src dist",
    "build": "bun run clean && bun run generate && bun run build:js && bun run build:types",
    "prepublishOnly": "bun run build"
  }
}
